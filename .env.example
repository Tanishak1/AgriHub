# AgriHub Environment Variables

# Backend Port
PORT=5000

# Database URL (SQLite path for development, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agrihub?schema=public"

# JWT secret for auth tokens
JWT_SECRET="agrihub_super_secret_jwt_token_key_change_me_in_production"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Node Env
NODE_ENV="development"
